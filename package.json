{
  "author": "大漠穷秋",
  "name": "ice-render",
  "version": "1.0.4",
  "description": "A canvas engine for interactive graphics.",
  "repository": "https://gitee.com/ice-render/ice-render",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "browser": "dist/index.umd.js",
  "main": "dist/index.cjs.js",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "start": "rollup -c -w  --environment NODE_ENV:development",
    "build": "npm run clean && npm run build:types && npm run build:js",
    "build:js": "rollup -c --environment NODE_ENV:production",
    "build:types": "tsc --emitDeclarationOnly",
    "clean": "rimraf dist",
    "pretty": "prettier src/**/* --write",
    "types:check": "tsc --noEmit",
    "types:watch": "npm run types:check -- --watch",
    "test": "jest",
    "bench": "node bench/render.cjs"
  },
  "dependencies": {
    "gl-matrix": "3.4.3",
    "lodash": "4.17.21"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-decorators": "7.28.0",
    "@babel/preset-env": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@commitlint/cli": "17.8.1",
    "@commitlint/config-conventional": "17.8.1",
    "@rollup/plugin-babel": "6.1.0",
    "@rollup/plugin-commonjs": "25.0.8",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-strip": "3.0.4",
    "@rollup/plugin-terser": "0.4.4",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.21",
    "@types/node": "18.19.130",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-jest": "27.9.0",
    "eslint-plugin-prettier": "5.5.4",
    "husky": "8.0.3",
    "jest": "29.7.0",
    "lint-staged": "15.5.2",
    "prettier": "3.7.4",
    "rimraf": "5.0.10",
    "rollup": "3.29.5",
    "rollup-plugin-license": "3.6.0",
    "rollup-plugin-visualizer": "6.0.5",
    "typescript": "5.9.3"
  },
  "keywords": [
    "canvas",
    "graphic"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "npm": ">=6.4.1",
    "node": ">=10.13.0"
  },
  "license": "MIT"
}
