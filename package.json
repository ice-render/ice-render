{
  "author": "大漠穷秋",
  "name": "ice-render",
  "version": "1.2.0",
  "description": "A canvas engine for interactive graphics.",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/ice-render/ice-render.git"
  },
  "type": "commonjs",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "browser": "dist/index.umd.js",
  "main": "dist/index.cjs",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "start": "rollup -c -w  --environment NODE_ENV:development",
    "build": "npm run clean && npm run build:types && npm run build:js",
    "build:js": "rollup -c --environment NODE_ENV:production",
    "build:types": "tsc --emitDeclarationOnly && node scripts/emit-dmts.cjs",
    "clean": "rimraf dist",
    "pretty": "prettier src/**/* --write",
    "types:check": "tsc --noEmit",
    "types:watch": "npm run types:check -- --watch",
    "test": "jest",
    "test:visual": "playwright test",
    "lint": "eslint src tests e2e --ext .ts,.js",
    "lint:fix": "eslint src tests e2e --ext .ts,.js --fix",
    "bench": "node bench/render.cjs",
    "bench:micro": "node bench/micro/index.mjs",
    "pkg:lint": "publint",
    "pkg:types": "attw --pack .",
    "pkg:check": "npm run pkg:lint && npm run pkg:types",
    "test:visual:ci": "playwright test e2e/visual/examples-smoke.spec.ts e2e/visual/interaction.spec.ts e2e/visual/dirty-rect-pixel.spec.ts e2e/visual/viewport.spec.ts e2e/visual/alignment.spec.ts e2e/visual/hidpi.spec.ts e2e/visual/worker-perf.spec.ts",
    "verify": "npm run lint && npm run types:check && npm run build && npm test -- --runInBand && npm run bench 2000 && npm run pkg:check",
    "verify:full": "npm run verify && npm run test:visual"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "7.28.5",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-decorators": "7.28.0",
    "@babel/preset-env": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@commitlint/cli": "17.8.1",
    "@commitlint/config-conventional": "17.8.1",
    "@playwright/test": "^1.40.0",
    "@rollup/plugin-babel": "6.1.0",
    "@rollup/plugin-commonjs": "25.0.8",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-strip": "3.0.4",
    "@rollup/plugin-terser": "0.4.4",
    "@types/jest": "29.5.14",
    "@types/node": "18.19.130",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-jest": "27.9.0",
    "eslint-plugin-prettier": "5.5.4",
    "gl-matrix": "3.4.3",
    "http-server": "^14.1.1",
    "husky": "8.0.3",
    "jest": "29.7.0",
    "lint-staged": "15.5.2",
    "mitata": "^1.0.34",
    "prettier": "3.7.4",
    "publint": "^0.3.24",
    "rimraf": "5.0.10",
    "rollup": "3.29.5",
    "rollup-plugin-license": "3.6.0",
    "rollup-plugin-visualizer": "6.0.5",
    "typescript": "5.9.3"
  },
  "keywords": [
    "canvas",
    "graphic"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "npm": ">=6.4.1",
    "node": ">=18"
  },
  "license": "MIT",
  "lint-staged": {
    "{src,tests,e2e}/**/*.{ts,js}": "eslint --fix"
  }
}
